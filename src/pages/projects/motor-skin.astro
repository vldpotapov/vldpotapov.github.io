---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import LogoMarquee from "../../components/LogoMarquee.astro";
import NameMarquee from "../../components/NameMarquee.astro";
import PlaceholderImage from "../../components/PlaceholderImage.astro";
import { moreProjects } from "../../data/site";
import "../../styles/global.css";
---

<BaseLayout title="Motor Skin - Potapov Visual Designer">
  <Header dark />

  <main>
    <section class="project-hero">
      <PlaceholderImage class="project-hero__image" label="" />
      <NameMarquee label="Motor Skin - Motor Skin -" />
    </section>

    <section class="project-intro section">
      <h1>Branding & Marketing</h1>
      <div>
        <p class="section-label">// Services</p>
        <p>
          For Motor Skin, we embraced the raw, powerful energy of motorsports while highlighting the precision and
          craftsmanship behind the gear. The design combined rugged aesthetics with sleek functionality, capturing the
          adrenaline of racing while emphasizing protection and performance in every detail.
        </p>
      </div>
    </section>

    <PlaceholderImage class="project-wide-image" label="" />
    <PlaceholderImage class="project-wide-image project-wide-image--blue" label="" />

    <section class="project-copy section">
      <p>
        For things sports, we became heavy fans of the target sports audience while keeping visual restraint. The result
        is a compact identity system that feels sharp, energetic and easy to apply across formats.
      </p>
      <p>
        The project focuses on texture, contrast and simple layouts that can carry both detailed visuals and short
        messages. These placeholder texts will later be replaced with the real project story.
      </p>
    </section>

    <PlaceholderImage class="project-wide-image project-wide-image--dark" label="" />

    <section class="more-projects section">
      <p class="section-label">// More Projects</p>
      <div class="more-projects__grid">
        {
          moreProjects.map((project) => (
            <a class="more-card" href={project.slug}>
              <PlaceholderImage class="more-card__image" label="" />
              <h2>{project.title}</h2>
              <p>({project.year})</p>
            </a>
          ))
        }
      </div>
    </section>

    <LogoMarquee />
  </main>

  <Footer />
</BaseLayout>
