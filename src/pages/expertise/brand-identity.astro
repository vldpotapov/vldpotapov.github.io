---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import LogoMarquee from "../../components/LogoMarquee.astro";
import MoreProjects from "../../components/MoreProjects.astro";
import ImageLightbox from "../../components/ImageLightbox.astro";
import ExploreExpertise from "../../components/ExploreExpertise.astro";
import { moreProjects, projects } from "../../data/site";
import "../../styles/global.css";

const selectedProjects = [projects[0], ...moreProjects.slice(0, 2)];

const visualSystemItems = [
  {
    title: "2020 — Early Visual Direction",
    description: [
      "The 2020 materials show an early stage of the visual language, when the brand was beginning to establish more consistent graphic principles across marketing communication.",
      "The system was still flexible and experimental, but recurring approaches to layout, typography, color, and imagery were already beginning to emerge.",
    ],
    video: "/videos/expertise/branding/slot-guide-2020.mp4",
    poster: "/videos/expertise/branding/posters/slot-guide-2020.png",
  },
  {
    title: "2022 — Developing Consistency",
    description: [
      "By 2022, the visual language had become more structured and recognizable.",
      "Graphic elements, digital layouts, presentation materials, and campaign visuals began to follow a more unified direction, creating stronger consistency across different formats and communication channels.",
    ],
    video: "/videos/expertise/branding/slot-guide-2022.mp4",
    poster: "/videos/expertise/branding/posters/slot-guide-2022.png",
  },
  {
    title: "2024 — Formalizing the System",
    description:
      "The 2024 brand book formalized the visual system, bringing typography, color, graphic elements, layout principles, and examples of application into one consistent reference.",
    video: "/videos/expertise/branding/brandbook-2024.mp4",
    poster: "/videos/expertise/branding/posters/brandbook-2024.png",
  },
  {
    title: "2026 — Evolved Brand System",
    description:
      "The 2026 brand book expands this system into a more flexible and digital-first identity, with updated principles for typography, imagery, graphic elements, 3D, and campaigns.",
    video: "/videos/expertise/branding/brandbook-2026.mp4",
    poster: "/videos/expertise/branding/posters/brandbook-2026.png",
  },
];

const socialMediaImages = Array.from({ length: 8 }, (_, index) => ({
  src: `/images/expertise/branding/smm-${index + 1}.png`,
  alt: `Slotegrator social media design example ${index + 1}`,
}));

const ebookImages = Array.from({ length: 5 }, (_, index) => ({
  src: `/images/expertise/branding/ebook-${index + 1}.png`,
  alt: `Slotegrator editorial and ebook design example ${index + 1}`,
}));

const editorialEditionImages = [
  { src: "/images/projects/igb-live-2026/prediction_digital_1.png", alt: "Prediction Markets digital eBook layout 1" },
  { src: "/images/projects/igb-live-2026/prediction_digital_2.png", alt: "Prediction Markets digital eBook layout 2" },
  { src: "/images/projects/igb-live-2026/prediction_digital_3.png", alt: "Prediction Markets digital eBook layout 3" },
  { src: "/images/projects/igb-live-2026/prediction_print_1.png", alt: "Prediction Markets printed eBook layout 1" },
  { src: "/images/projects/igb-live-2026/prediction_print_2.png", alt: "Prediction Markets printed eBook layout 2" },
  { src: "/images/projects/igb-live-2026/prediction_print_3.png", alt: "Prediction Markets printed eBook layout 3" },
];

const keyVisualVideos = [
  {
    video: "/videos/expertise/branding/keyvisual-1.mp4",
    poster: "/videos/expertise/branding/posters/keyvisual-1.png",
    alt: "Slotegrator 3D key visual animation 1",
  },
  {
    video: "/videos/expertise/branding/keyvisual-2.mp4",
    poster: "/videos/expertise/branding/posters/keyvisual-2.png",
    alt: "Slotegrator 3D key visual animation 2",
  },
];
---

<BaseLayout
  title="Brand Identity | Potapov Visual Designer"
  description="Brand identity, visual systems, and branding work by Vladimir Potapov."
>
  <Header />

  <main class="expertise-page expertise-page--brand-identity">
    <div class="expertise-hero-scroll" data-expertise-hero-scroll>
      <section class="expertise-hero" aria-labelledby="brand-identity-title">
        <div class="expertise-hero__title-block">
          <h1 class="expertise-hero__title" id="brand-identity-title">Brand Identity</h1>
        </div>
      </section>

      <section class="expertise-overview" aria-labelledby="brand-overview-title">
        <div class="expertise-overview__image-stage" data-expertise-image-stage>
          <img
            class="expertise-overview__image"
            src="/images/expertise/branding/branding-hero.png"
            alt="Brand identity visual system"
          />
          <div class="expertise-overview__image-overlay" aria-hidden="true"></div>
        </div>

        <div class="expertise-overview__content-layer">
          <div class="expertise-overview__inner">
            <div class="expertise-overview__spacer" aria-hidden="true"></div>
            <div class="expertise-overview__copy">
              <h2 class="section-label" id="brand-overview-title">// Overview</h2>
              <p class="intro-reveal" data-intro-reveal>
                I develop visual identities for existing brands, helping them evolve while staying recognizable and consistent.
                <span> I turn individual design solutions into flexible, coherent systems. </span>My work spans visual direction, key visuals, 3D, digital products, campaigns, print, events, and motion.
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>

    <section class="expertise-visual-language" aria-labelledby="visual-language-title">
      <h2 class="section-label" id="visual-language-title">// Visual Language</h2>

      <div class="expertise-visual-language__intro">
        <div class="expertise-visual-language__spacer" aria-hidden="true"></div>
        <div class="expertise-visual-language__copy" data-reveal="left">
          <h3>Brand Evolution</h3>
          <div>
            <p>Slotegrator is a clear example of how a brand can evolve through continuous design work rather than a single isolated redesign.</p>
            <p>Over several years, I worked alongside the marketing and design team to develop and apply its visual language across digital products, campaigns, 3D, social media, editorial materials, and brand guidelines.</p>
          </div>
        </div>
      </div>

      <figure class="expertise-visual-language__media" data-reveal="bottom">
        <button
          class="expertise-lightbox-media"
          type="button"
          aria-label="Open Logo Evolution image"
          data-lightbox-image
        >
          <img
            src="/images/expertise/branding/logo.png"
            alt="Evolution of the Slotegrator logo from 2019 to 2026"
            loading="lazy"
            decoding="async"
          />
        </button>
        <figcaption class="expertise-visual-language__caption media-caption">
          <h3>Logo Evolution</h3>
          <p>Across several iterations, the Slotegrator logo became simpler, more confident, and more adaptable, while preserving a recognizable connection to the original identity.</p>
        </figcaption>
      </figure>

      <figure class="expertise-visual-language__media">
        <div class="expertise-visual-language__gallery">
          <button
            class="expertise-lightbox-media"
            type="button"
            aria-label="Open website evolution image from 2019 to 2023"
            data-lightbox-image
            data-reveal="bottom"
            data-reveal-delay="0"
          >
            <img
              src="/images/expertise/branding/web main.png"
              alt="Evolution of the Slotegrator website from 2019 to 2023"
              loading="lazy"
              decoding="async"
            />
          </button>

          <button
            class="expertise-lightbox-media"
            type="button"
            aria-label="Open product pages evolution image"
            data-lightbox-image
            data-reveal="bottom"
            data-reveal-delay="100"
          >
            <img
              src="/images/expertise/branding/web-products.png"
              alt="Evolution of Slotegrator digital product pages"
              loading="lazy"
              decoding="async"
            />
          </button>

          <button
            class="expertise-lightbox-media"
            type="button"
            aria-label="Open 2026 website evolution image"
            data-lightbox-image
            data-reveal="bottom"
            data-reveal-delay="200"
          >
            <img
              src="/images/expertise/branding/web-2026.png"
              alt="Slotegrator website visual system in 2026"
              loading="lazy"
              decoding="async"
            />
          </button>
        </div>

        <figcaption class="expertise-visual-language__caption media-caption" data-reveal="bottom">
          <h3>Digital Evolution</h3>
          <p>The evolution of Slotegrator’s website and product pages reflects the broader development of the brand — from information-led layouts to a more structured digital system with clearer hierarchy, consistent art direction, and distinct product key visuals.</p>
        </figcaption>
      </figure>

      <div class="expertise-system">
        <div class="expertise-system__intro content-intro" data-reveal="right">
          <h3>Building the Visual System</h3>
          <p>The brand’s visual language evolved through typography, color, graphic elements, 3D, and motion, gradually forming a more consistent and flexible system.</p>
        </div>

        <div class="expertise-system__list">
          {visualSystemItems.map((item) => (
            <article class="expertise-system__item" data-reveal="bottom">
              <figure class="expertise-system__video">
                <video
                  src={item.video}
                  poster={item.poster}
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  data-hover-video
                  aria-label={item.title}
                ></video>
              </figure>
              <div class="expertise-visual-language__caption media-caption">
                <h3>{item.title}</h3>
                {(Array.isArray(item.description) ? item.description : [item.description]).map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="expertise-identity-use">
        <div class="expertise-system__intro content-intro" data-reveal="right">
          <h3>Selected Applications</h3>
          <p>A visual identity becomes meaningful through consistent real-world application. These selected examples show how the Slotegrator visual language adapts to different formats while retaining a recognizable overall character.</p>
        </div>

        <div class="expertise-identity-use__list">
          <article class="expertise-identity-use__item">
            <div class="expertise-identity-use__copy media-caption" data-reveal="bottom">
              <h3>Social Media</h3>
              <p>A flexible visual system keeps diverse topics, formats, and campaigns consistent across social media.</p>
            </div>
            <div class="expertise-identity-use__gallery">
              {socialMediaImages.map((image, index) => (
                <button
                  class="expertise-lightbox-media"
                  type="button"
                  aria-label={`Open ${image.alt}`}
                  data-lightbox-image
                  data-reveal="bottom"
                  data-reveal-delay={index * 100}
                >
                  <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          </article>

          <article class="expertise-identity-use__item">
            <div class="expertise-identity-use__copy media-caption" data-reveal="bottom">
              <h3>Editorial &amp; eBooks</h3>
              <p>Typography, illustration, infographics, and 3D bring clarity and a consistent identity to complex editorial content.</p>
            </div>
            <div class="expertise-identity-use__gallery">
              {ebookImages.map((image, index) => (
                <button
                  class="expertise-lightbox-media"
                  type="button"
                  aria-label={`Open ${image.alt}`}
                  data-lightbox-image
                  data-reveal="bottom"
                  data-reveal-delay={index * 100}
                >
                  <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
            <div class="expertise-editorial-editions">
              {editorialEditionImages.map((image, index) => (
                <button
                  class="expertise-lightbox-media"
                  type="button"
                  aria-label={`Open ${image.alt}`}
                  data-lightbox-image
                  data-reveal="right"
                  data-reveal-delay={index * 100}
                >
                  <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          </article>

          <article class="expertise-identity-use__item">
            <div class="expertise-identity-use__copy media-caption" data-reveal="bottom">
              <h3>3D Key Visuals</h3>
              <p>Individual product ideas are united through shared materials, lighting, composition, and visual direction.</p>
            </div>
            <div class="expertise-identity-use__gallery expertise-identity-use__gallery--video">
              {keyVisualVideos.map((item, index) => (
                <figure class="expertise-system__video" data-reveal="bottom" data-reveal-delay={index * 100}>
                  <video
                    src={item.video}
                    poster={item.poster}
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    data-hover-video
                    aria-label={item.alt}
                  ></video>
                </figure>
              ))}
            </div>
          </article>
        </div>
      </div>
    </section>

    <MoreProjects
      projects={selectedProjects}
      title="// Selected Projects"
      singleColumnBreakpoint
      selected
    />

    <ExploreExpertise currentSlug="brand-identity" />

    <LogoMarquee />
  </main>

  <Footer />
  <ImageLightbox />
</BaseLayout>

<script>
  const setupExpertiseHeroScroll = () => {
    const root = document.querySelector<HTMLElement>("[data-expertise-hero-scroll]");
    const stage = root?.querySelector<HTMLElement>("[data-expertise-image-stage]");
    const hero = root?.querySelector<HTMLElement>(".expertise-hero");

    if (!root || !stage || !hero || root.dataset.scrollReady === "true") return;
    root.dataset.scrollReady = "true";

    let stageTop = 0;
    let rootTop = 0;
    let stickyTop = 0;
    let whiteningDistance = 1;
    let holdDistance = 0;
    let isMobile = false;
    let frame = 0;

    const measure = () => {
      let offset = 0;
      let node: HTMLElement | null = stage;

      while (node && node !== root) {
        offset += node.offsetTop;
        node = node.offsetParent as HTMLElement | null;
      }

      rootTop = window.scrollY + root.getBoundingClientRect().top;
      stageTop = rootTop + offset;
      stickyTop = Math.max(0, hero.offsetHeight - stage.offsetHeight);
      root.style.setProperty("--expertise-image-stick-top", `${stickyTop}px`);
      isMobile = window.matchMedia("(max-width: 760px)").matches;
      whiteningDistance = isMobile
        ? Math.max(1, Math.min(stage.offsetHeight * 1, window.innerHeight * 1.6))
        : Math.max(1, Math.min(stage.offsetHeight * 0.3, window.innerHeight * 0.25));
      holdDistance = Math.max(
        0,
        (window.innerHeight - stickyTop + whiteningDistance - stage.offsetHeight) * 0.5,
      );
      root.style.setProperty("--expertise-image-hold", `${holdDistance}px`);
    };

    const render = () => {
      frame = 0;
      const stickyStart = stageTop - stickyTop;
      const progress = Math.min(1, Math.max(0, (window.scrollY - stickyStart) / whiteningDistance));
      root.style.setProperty("--expertise-hero-whiten", progress.toFixed(4));

      const titleTravel =
        Math.min(Math.max(0, window.scrollY - rootTop), Math.max(0, stickyStart - rootTop)) * 0.7;
      root.style.setProperty("--expertise-title-shift", `${-titleTravel.toFixed(2)}px`);
    };

    const requestRender = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(render);
    };

    const refresh = () => {
      measure();
      render();
    };

    window.addEventListener("scroll", requestRender, { passive: true });
    window.addEventListener("resize", refresh);
    window.addEventListener("pageshow", refresh);

    const image = stage.querySelector("img");
    if (image && !image.complete) image.addEventListener("load", refresh, { once: true });

    refresh();
  };

  setupExpertiseHeroScroll();
</script>

<script>
  const initExpertiseReveals = () => {
    const elements = document.querySelectorAll<HTMLElement>(
      ".expertise-page [data-reveal]:not([data-reveal-ready])",
    );
    if (!elements.length) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduceMotion) {
      elements.forEach((element) => {
        element.dataset.revealReady = "true";
        element.style.opacity = "1";
        element.style.transform = "none";
      });
      return;
    }

    const reveal = (element: HTMLElement) => {
      if (element.dataset.revealQueued === "true") return;
      element.dataset.revealQueued = "true";
      const delay = Number.parseInt(element.dataset.revealDelay || "0", 10);

      window.setTimeout(() => {
        element.classList.add("is-revealed");
        element.addEventListener(
          "animationend",
          () => {
            element.style.animation = "none";
            element.style.opacity = "1";
            element.style.transform = "none";
          },
          { once: true },
        );
      }, delay);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const element = entry.target as HTMLElement;
          reveal(element);
          observer.unobserve(element);
        });
      },
      { threshold: 0, rootMargin: "0px 0px -20px 0px" },
    );

    elements.forEach((element) => {
      element.dataset.revealReady = "true";
      observer.observe(element);
    });
  };

  initExpertiseReveals();
  document.addEventListener("astro:page-load", initExpertiseReveals);
</script>

<script>
  const initExpertiseVideos = () => {
    const videos = document.querySelectorAll<HTMLVideoElement>(".expertise-page [data-hover-video]");
    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    videos.forEach((video) => {
      if (video.dataset.videoReady === "true") return;
      video.dataset.videoReady = "true";
      video.muted = true;
      video.loop = true;
      video.playsInline = true;
      video.removeAttribute("controls");

      if (canHover) {
        video.addEventListener("pointerenter", () => video.play().catch(() => {}));
        video.addEventListener("pointerleave", () => video.pause());
      } else {
        video.addEventListener("touchstart", () => video.play().catch(() => {}), { passive: true });
      }
    });
  };

  initExpertiseVideos();
  document.addEventListener("astro:page-load", initExpertiseVideos);
</script>
