---
import LogoMark from "../components/LogoMark.astro";

const {
  title = "Potapov Visual Designer",
  description = "Graphic design and 3D portfolio.",
  ogImage = "/images/og/og-home.jpg",
  ogType = "website",
} = Astro.props;

const siteUrl = "https://vpotapov.pages.dev";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline>
      // @ts-nocheck
      try {
        if (
          window.matchMedia("(prefers-reduced-motion: no-preference)").matches &&
          sessionStorage.getItem("pageTransition") === "true"
        ) {
          document.documentElement.classList.add("is-page-entering");
        }
      } catch {}
    </script>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content="Potapov Visual Designer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300&family=Google+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page-transition" aria-hidden="true">
      <div class="page-transition__layer page-transition__layer--black"></div>
      <div class="page-transition__layer page-transition__layer--accent"></div>
    </div>
    <div class="site-shell" data-site-shell>
      <a class="brand-mark-dot-link" href="/" aria-label="Home" tabindex="-1" aria-hidden="true">
        <LogoMark part="dot" />
      </a>
      <slot />
    </div>
    <script>
      // @ts-nocheck
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const parallaxItems = Array.from(document.querySelectorAll(".hero__portrait, .case-hero__image"));
      let ticking = false;

      function updateHeroParallax() {
        if (
          reduceMotion.matches ||
          document.documentElement.classList.contains("is-page-entering") ||
          document.documentElement.classList.contains("is-page-leaving")
        ) {
          ticking = false;
          return;
        }

        for (const item of parallaxItems) {
          const parent = item.parentElement;
          if (!parent) continue;

          const rect = parent.getBoundingClientRect();
          const viewportHeight = window.innerHeight || document.documentElement.clientHeight;

          if (rect.bottom < 0 || rect.top > viewportHeight) continue;

          const offset = rect.top * -0.5;
          item.style.transform = `translate3d(0, ${offset}px, 0)`;
        }

        ticking = false;
      }

      function requestHeroParallax() {
        if (ticking || reduceMotion.matches) return;
        ticking = true;
        requestAnimationFrame(updateHeroParallax);
      }

      updateHeroParallax();
      window.addEventListener("scroll", requestHeroParallax, { passive: true });
      window.addEventListener("resize", requestHeroParallax);
      window.addEventListener("load", requestHeroParallax);
      window.addEventListener("pageTransitionComplete", requestHeroParallax);
    </script>
    <script>
      // @ts-nocheck
      const introRevealItems = Array.from(document.querySelectorAll("[data-intro-reveal]"));
      const introReduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let introRevealTicking = false;
      let introRevealResizeTimer = 0;

      function wrapIntroText(node, accent = false) {
        if (node.nodeType === Node.TEXT_NODE) {
          const fragment = document.createDocumentFragment();
          const parts = node.textContent?.split(/(\s+)/) || [];

          for (const part of parts) {
            if (!part) continue;

            if (/^\s+$/.test(part)) {
              fragment.appendChild(document.createTextNode(part));
              continue;
            }

            const word = document.createElement("span");
            word.dataset.introWord = "";
            if (accent) word.dataset.introAccent = "true";
            word.textContent = part;
            fragment.appendChild(word);
          }

          node.replaceWith(fragment);
          return;
        }

        if (node.nodeType !== Node.ELEMENT_NODE) return;

        const isAccent = accent || node.matches("span");
        Array.from(node.childNodes).forEach((child) => wrapIntroText(child, isAccent));
      }

      function prepareIntroReveal() {
        for (const item of introRevealItems) {
          if (item.dataset.introPrepared === "true") continue;
          Array.from(item.childNodes).forEach((child) => wrapIntroText(child));
          item.dataset.introPrepared = "true";
        }
      }

      function getIntroLines(item) {
        const words = Array.from(item.querySelectorAll("[data-intro-word]"));
        const lines = [];

        for (const word of words) {
          const top = Math.round(word.offsetTop);
          let line = lines.find((candidate) => Math.abs(candidate.top - top) <= 2);

          if (!line) {
            line = { top, words: [] };
            lines.push(line);
          }

          line.words.push(word);
        }

        return lines.sort((a, b) => a.top - b.top);
      }

      function updateIntroReveal() {
        if (!introRevealItems.length) {
          introRevealTicking = false;
          return;
        }

        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;

        for (const item of introRevealItems) {
          const words = Array.from(item.querySelectorAll("[data-intro-word]"));

          if (introReduceMotion.matches) {
            words.forEach((word) => word.style.setProperty("--word-reveal", "100%"));
            continue;
          }

          const rect = item.getBoundingClientRect();
          const start = viewportHeight * 0.8;
          const end = viewportHeight * 0.2;
          const progress = Math.min(1, Math.max(0, (start - rect.top) / (start - end)));
          const lines = getIntroLines(item);
          const lineCount = Math.max(lines.length, 1);

          lines.forEach((line, index) => {
            const lineProgress = Math.min(1, Math.max(0, progress * lineCount - index));

            line.words.forEach((word, wordIndex) => {
              const wordStart = wordIndex / line.words.length;
              const wordEnd = (wordIndex + 1) / line.words.length;
              const wordProgress = Math.min(1, Math.max(0, (lineProgress - wordStart) / (wordEnd - wordStart)));
              word.style.setProperty("--word-reveal", `${(wordProgress * 100).toFixed(2)}%`);
            });
          });
        }

        introRevealTicking = false;
      }

      function requestIntroReveal() {
        if (introRevealTicking || !introRevealItems.length) return;
        introRevealTicking = true;
        requestAnimationFrame(updateIntroReveal);
      }

      prepareIntroReveal();
      updateIntroReveal();
      window.addEventListener("scroll", requestIntroReveal, { passive: true });
      window.addEventListener("resize", () => {
        window.clearTimeout(introRevealResizeTimer);
        introRevealResizeTimer = window.setTimeout(requestIntroReveal, 120);
      });
    </script>
    <script>
      // @ts-nocheck
      const serviceFlipRoot = document.querySelector("[data-service-flip]");

      if (serviceFlipRoot) {
        const currentNumber = serviceFlipRoot.querySelector(".service__number--current");
        const nextNumber = serviceFlipRoot.querySelector(".service__number--next");
        const currentNumberUse = currentNumber?.querySelector(".service__number-use");
        const nextNumberUse = nextNumber?.querySelector(".service__number-use");
        const serviceItems = Array.from(serviceFlipRoot.querySelectorAll(".service[data-service-number]"));
        let activeNumber = currentNumberUse?.getAttribute("href")?.replace("#service-number-", "") || "01";
        let isAnimatingNumber = false;
        let queuedNumber = null;

        function flipToServiceNumber(number) {
          if (!currentNumber || !nextNumber || !currentNumberUse || !nextNumberUse || number === activeNumber) return;

          if (isAnimatingNumber) {
            queuedNumber = number;
            return;
          }

          isAnimatingNumber = true;
          nextNumberUse.setAttribute("href", `#service-number-${number}`);
          currentNumber.classList.add("is-flip-out");

          window.setTimeout(() => {
            nextNumber.classList.add("is-flip-in");
          }, 320);

          window.setTimeout(() => {
            currentNumberUse.setAttribute("href", `#service-number-${number}`);
            currentNumber.classList.remove("is-flip-out");
            nextNumber.classList.remove("is-flip-in");
            nextNumberUse.setAttribute("href", `#service-number-${number}`);
            activeNumber = number;
            isAnimatingNumber = false;

            if (queuedNumber && queuedNumber !== activeNumber) {
              const queued = queuedNumber;
              queuedNumber = null;
              flipToServiceNumber(queued);
            } else {
              queuedNumber = null;
            }
          }, 660);
        }

        const serviceObserver = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

            const number = visible?.target?.getAttribute("data-service-number");
            if (number) flipToServiceNumber(number);
          },
          {
            threshold: [0.35, 0.5, 0.65],
            rootMargin: "-30% 0px -30% 0px",
          },
        );

        serviceItems.forEach((item) => serviceObserver.observe(item));
      }
    </script>
    <script>
      // @ts-nocheck
      const footerReveal = document.querySelector(".footer__portrait");
      const footerRevealImage = footerReveal?.querySelector(".footer__image");
      const footerRevealOverlay = footerReveal?.querySelector(".footer__overlay");
      const footerReduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let footerRevealTicking = false;

      function updateFooterReveal() {
        if (!footerReveal || !footerRevealImage || !footerRevealOverlay) {
          footerRevealTicking = false;
          return;
        }

        if (footerReduceMotion.matches) {
          footerRevealImage.style.transform = "none";
          footerRevealOverlay.style.opacity = "0";
          footerRevealTicking = false;
          return;
        }

        const rect = footerReveal.getBoundingClientRect();
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        const progress = Math.min(1, Math.max(0, (viewportHeight - rect.top) / viewportHeight));
        const imageOffset = (1 - progress) * viewportHeight * -0.5;
        const overlayOpacity = 1 - progress;

        footerRevealImage.style.transform = `translate3d(0, ${imageOffset}px, 0)`;
        footerRevealOverlay.style.opacity = overlayOpacity.toFixed(3);
        footerRevealTicking = false;
      }

      function requestFooterReveal() {
        if (footerRevealTicking || !footerReveal) return;
        footerRevealTicking = true;
        requestAnimationFrame(updateFooterReveal);
      }

      updateFooterReveal();
      window.addEventListener("scroll", requestFooterReveal, { passive: true });
      window.addEventListener("resize", requestFooterReveal);
    </script>
    <script>
      // @ts-nocheck
      const pointerFine = window.matchMedia("(hover: hover) and (pointer: fine)");
      const motionSafe = window.matchMedia("(prefers-reduced-motion: no-preference)");

      if (pointerFine.matches) {
        document.querySelectorAll(".button").forEach((button) => {
          button.addEventListener("pointermove", (event) => {
            const rect = button.getBoundingClientRect();
            button.style.setProperty("--button-fill-x", `${event.clientX - rect.left}px`);
            button.style.setProperty("--button-fill-y", `${event.clientY - rect.top}px`);
          });
        });
      }

      const projectLinks = document.querySelectorAll(".project-card, .more-card, [data-view-cursor]");

      if (pointerFine.matches && motionSafe.matches && projectLinks.length) {
        const viewCursor = document.createElement("div");
        viewCursor.className = "project-view-cursor";
        viewCursor.textContent = "View";
        document.body.appendChild(viewCursor);

        let cursorX = 0;
        let cursorY = 0;
        let cursorTicking = false;

        function updateViewCursor() {
          viewCursor.style.left = `${cursorX}px`;
          viewCursor.style.top = `${cursorY}px`;
          cursorTicking = false;
        }

        function requestViewCursor(event) {
          cursorX = event.clientX;
          cursorY = event.clientY;

          if (cursorTicking) return;
          cursorTicking = true;
          requestAnimationFrame(updateViewCursor);
        }

        projectLinks.forEach((card) => {
          card.addEventListener("pointerenter", (event) => {
            requestViewCursor(event);
            viewCursor.textContent = card.dataset.viewCursor || "View";
            viewCursor.classList.add("is-visible");
          });
          card.addEventListener("pointermove", requestViewCursor);
          card.addEventListener("pointerleave", () => {
            viewCursor.classList.remove("is-visible");
          });
        });
      }
    </script>
    <script>
      // @ts-nocheck
      const pageTransitionMotion = window.matchMedia("(prefers-reduced-motion: no-preference)");
      const pageTransitionDuration = 620;
      let pageTransitionTimer = 0;

      function resetPageTransition() {
        window.clearTimeout(pageTransitionTimer);
        sessionStorage.removeItem("pageTransition");
        document.documentElement.classList.remove("is-page-leaving", "is-page-entering");
        requestAnimationFrame(() => {
          window.dispatchEvent(new Event("pageTransitionComplete"));
          window.dispatchEvent(new Event("resize"));
          window.dispatchEvent(new Event("scroll"));
        });
      }

      function isInternalPageLink(link) {
        if (!link || link.target || link.hasAttribute("download")) return false;
        const rawHref = link.getAttribute("href") || "";
        if (rawHref.startsWith("#")) return false;
        if (link.origin !== window.location.origin) return false;
        if (link.pathname === window.location.pathname && link.hash) return false;
        return link.href !== window.location.href;
      }

      if (pageTransitionMotion.matches) {
        window.addEventListener("pageshow", (event) => {
          const navigationEntry = performance.getEntriesByType("navigation")[0];
          const isHistoryNavigation =
            event.persisted ||
            (navigationEntry instanceof PerformanceNavigationTiming && navigationEntry.type === "back_forward");

          if (isHistoryNavigation || document.documentElement.classList.contains("is-page-leaving")) {
            resetPageTransition();
          }
        });

        if (sessionStorage.getItem("pageTransition") === "true") {
          sessionStorage.removeItem("pageTransition");
          document.documentElement.classList.add("is-page-entering");
          pageTransitionTimer = window.setTimeout(() => {
            document.documentElement.classList.remove("is-page-entering");
            requestAnimationFrame(() => {
              window.dispatchEvent(new Event("pageTransitionComplete"));
              window.dispatchEvent(new Event("resize"));
              window.dispatchEvent(new Event("scroll"));
            });
          }, pageTransitionDuration);
        }

        document.addEventListener("click", (event) => {
          if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          const link = event.target instanceof Element ? event.target.closest("a") : null;
          if (!(link instanceof HTMLAnchorElement) || !isInternalPageLink(link)) return;

          event.preventDefault();
          sessionStorage.setItem("pageTransition", "true");
          document.documentElement.classList.add("is-page-leaving");

          pageTransitionTimer = window.setTimeout(() => {
            window.location.href = link.href;
          }, pageTransitionDuration);
        });
      }
    </script>
  </body>
</html>

















