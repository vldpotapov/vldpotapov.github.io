---
const {
  title = "Potapov Visual Designer",
  description = "Graphic design and 3D portfolio.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300&family=Google+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const parallaxItems = Array.from(document.querySelectorAll(".hero__portrait, .project-hero__image"));
      let ticking = false;

      function updateHeroParallax() {
        if (reduceMotion.matches) return;

        for (const item of parallaxItems) {
          const parent = item.parentElement;
          if (!parent) continue;

          const rect = parent.getBoundingClientRect();
          const viewportHeight = window.innerHeight || document.documentElement.clientHeight;

          if (rect.bottom < 0 || rect.top > viewportHeight) continue;

          const offset = rect.top * -0.5;
          item.style.transform = `translate3d(0, ${offset}px, 0)`;
        }

        ticking = false;
      }

      function requestHeroParallax() {
        if (ticking || reduceMotion.matches) return;
        ticking = true;
        requestAnimationFrame(updateHeroParallax);
      }

      updateHeroParallax();
      window.addEventListener("scroll", requestHeroParallax, { passive: true });
      window.addEventListener("resize", requestHeroParallax);
    </script>
    <script>
      const serviceFlipRoot = document.querySelector("[data-service-flip]");

      if (serviceFlipRoot) {
        const currentNumber = serviceFlipRoot.querySelector(".service__number--current");
        const nextNumber = serviceFlipRoot.querySelector(".service__number--next");
        const serviceItems = Array.from(serviceFlipRoot.querySelectorAll(".service[data-service-number]"));
        let activeNumber = currentNumber?.textContent?.trim() || "01";
        let isAnimatingNumber = false;
        let queuedNumber = null;

        function flipToServiceNumber(number) {
          if (!currentNumber || !nextNumber || number === activeNumber) return;

          if (isAnimatingNumber) {
            queuedNumber = number;
            return;
          }

          isAnimatingNumber = true;
          nextNumber.textContent = number;
          currentNumber.classList.add("is-flip-out");

          window.setTimeout(() => {
            nextNumber.classList.add("is-flip-in");
          }, 320);

          window.setTimeout(() => {
            currentNumber.textContent = number;
            currentNumber.classList.remove("is-flip-out");
            nextNumber.classList.remove("is-flip-in");
            nextNumber.textContent = number;
            activeNumber = number;
            isAnimatingNumber = false;

            if (queuedNumber && queuedNumber !== activeNumber) {
              const queued = queuedNumber;
              queuedNumber = null;
              flipToServiceNumber(queued);
            } else {
              queuedNumber = null;
            }
          }, 660);
        }

        const serviceObserver = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

            const number = visible?.target?.getAttribute("data-service-number");
            if (number) flipToServiceNumber(number);
          },
          {
            threshold: [0.35, 0.5, 0.65],
            rootMargin: "-30% 0px -30% 0px",
          },
        );

        serviceItems.forEach((item) => serviceObserver.observe(item));
      }
    </script>
    <script>
      const footerReveal = document.querySelector(".footer__portrait");
      const footerRevealImage = footerReveal?.querySelector(".footer__image");
      const footerRevealOverlay = footerReveal?.querySelector(".footer__overlay");
      const footerReduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let footerRevealTicking = false;

      function updateFooterReveal() {
        if (!footerReveal || !footerRevealImage || !footerRevealOverlay) {
          footerRevealTicking = false;
          return;
        }

        if (footerReduceMotion.matches) {
          footerRevealImage.style.transform = "none";
          footerRevealOverlay.style.opacity = "0";
          footerRevealTicking = false;
          return;
        }

        const rect = footerReveal.getBoundingClientRect();
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        const progress = Math.min(1, Math.max(0, (viewportHeight - rect.top) / viewportHeight));
        const imageOffset = (1 - progress) * viewportHeight * -0.5;
        const overlayOpacity = 1 - progress;

        footerRevealImage.style.transform = `translate3d(0, ${imageOffset}px, 0)`;
        footerRevealOverlay.style.opacity = overlayOpacity.toFixed(3);
        footerRevealTicking = false;
      }

      function requestFooterReveal() {
        if (footerRevealTicking || !footerReveal) return;
        footerRevealTicking = true;
        requestAnimationFrame(updateFooterReveal);
      }

      updateFooterReveal();
      window.addEventListener("scroll", requestFooterReveal, { passive: true });
      window.addEventListener("resize", requestFooterReveal);
    </script>
  </body>
</html>








