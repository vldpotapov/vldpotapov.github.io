---
import { heroSocialLinks } from "../data/site";
import LogoMark from "./LogoMark.astro";

const { dark = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navItems = [
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const isActivePath = (href: string) => {
  const cleanHref = href.replace(/\/$/, "") || "/";
  return currentPath === cleanHref || (cleanHref !== "/" && currentPath.startsWith(`${cleanHref}/`));
};
---

<header class:list={["site-header", { "site-header--dark": dark }]}>
  <a class="brand-mark-link" href="/" aria-label="Home">
    <LogoMark part="shape" />
  </a>

  <a class="brand" href="/" aria-label="Home">
    <img class="brand__mark" src="/icons/main/logo-mark.svg" alt="" />
    <span>Potapov Visual Designer</span>
  </a>

  <nav class="desktop-nav" aria-label="Main navigation">
    {navItems.map((item) => isActivePath(item.href) ? (
      <span class="nav-link is-active" aria-current="page"><span>{item.label}</span></span>
    ) : (
      <a class="nav-link" href={item.href}><span>{item.label}</span></a>
    ))}
    <a href="/files/Vladimir_Potapov_CV.pdf" class="with-icon" target="_blank" rel="noopener noreferrer">
      <img src="/icons/social/pdfdoc.svg" alt="" />
      <span>CV</span>
    </a>
  </nav>

  <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false">
    <img src="/icons/ui/burgermenu.svg" alt="" />
  </button>

  <button class="mobile-menu-backdrop" type="button" aria-label="Close menu"></button>

  <div class="mobile-panel" aria-hidden="true">
    <div class="mobile-panel__top">
      <a class="brand" href="/" aria-label="Home">
        <img class="brand__mark" src="/icons/main/logo-mark.svg" alt="" />
        <span>Potapov Visual Designer</span>
      </a>
      <button class="menu-close" type="button" aria-label="Close menu">
        <img src="/icons/ui/close.svg" alt="" />
      </button>
    </div>
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {navItems.map((item) => isActivePath(item.href) ? (
        <span class="nav-link is-active" aria-current="page"><span>{item.label}</span></span>
      ) : (
        <a class="nav-link" href={item.href}><span>{item.label}</span></a>
      ))}
      <a href="/files/Vladimir_Potapov_CV.pdf" target="_blank" rel="noopener noreferrer">
        <img src="/icons/social/pdfdoc.svg" alt="" />
        <span>CV</span>
      </a>
    </nav>
    <div class="mobile-socials">
      {heroSocialLinks.map((link) => (
        <a href={link.href} aria-label={link.label} target="_blank" rel="noopener noreferrer">
          <img src={link.icon} alt="" />
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const header = document.querySelector(".site-header");
  const openButton = header?.querySelector(".menu-toggle");
  const closeButton = header?.querySelector(".menu-close");
  const backdrop = header?.querySelector(".mobile-menu-backdrop");
  const panel = header?.querySelector(".mobile-panel");

  function setMenu(open) {
    header?.classList.toggle("is-open", open);
    openButton?.setAttribute("aria-expanded", String(open));
    panel?.setAttribute("aria-hidden", String(!open));
    document.documentElement.classList.toggle("menu-open", open);
  }

  openButton?.addEventListener("click", () => setMenu(true));
  closeButton?.addEventListener("click", () => setMenu(false));
  backdrop?.addEventListener("click", () => setMenu(false));
  panel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  let lastScrollY = window.scrollY;
  let headerTicking = false;
  let floatingHeaderVisible = false;
  let wasPastHero = false;

  function getHeaderRevealStart() {
    return Math.max(window.innerHeight || document.documentElement.clientHeight, 760);
  }

  function updateScrollHeader() {
    if (!header) {
      headerTicking = false;
      return;
    }

    const currentScrollY = Math.max(window.scrollY, 0);
    const revealStart = getHeaderRevealStart();
    const isPastHero = currentScrollY > revealStart;
    const scrollDelta = currentScrollY - lastScrollY;
    const isScrollingUp = scrollDelta < -2;
    const isScrollingDown = scrollDelta > 2;
    const isMenuOpen = header.classList.contains("is-open");

    if (!isPastHero) {
      floatingHeaderVisible = false;
    } else if (isScrollingUp || isMenuOpen) {
      floatingHeaderVisible = true;
    } else if (isScrollingDown) {
      floatingHeaderVisible = false;
    }

    const isEnteringHiddenFloating = isPastHero && !wasPastHero && !floatingHeaderVisible;

    if (isEnteringHiddenFloating) {
      header.classList.add("is-no-transition");
    }

    header.classList.toggle("is-floating", isPastHero);
    header.classList.toggle("is-visible", isPastHero && floatingHeaderVisible);
    document.documentElement.classList.toggle("header-is-floating", isPastHero);
    document.documentElement.classList.toggle("header-is-visible", isPastHero && floatingHeaderVisible);

    if (!isPastHero) {
      header.classList.remove("is-visible");
      document.documentElement.classList.remove("header-is-visible");
    }

    if (isEnteringHiddenFloating) {
      requestAnimationFrame(() => header.classList.remove("is-no-transition"));
    }

    wasPastHero = isPastHero;

    if (Math.abs(scrollDelta) > 2) {
      lastScrollY = currentScrollY;
    }
    headerTicking = false;
  }

  function requestScrollHeader() {
    if (headerTicking) return;
    headerTicking = true;
    requestAnimationFrame(updateScrollHeader);
  }

  updateScrollHeader();
  window.addEventListener("scroll", requestScrollHeader, { passive: true });
  window.addEventListener("resize", requestScrollHeader);
  window.addEventListener("pageTransitionComplete", requestScrollHeader);
</script>
