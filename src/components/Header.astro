---
import { heroSocialLinks } from "../data/site";

const { dark = false } = Astro.props;
---

<a class:list={["brand-mark-link", { "brand-mark-link--dark": dark }]} href="/" aria-label="Home">
  <img class="brand__mark" src="/icons/main/logo-mark.svg" alt="" />
</a>

<header class:list={["site-header", { "site-header--dark": dark }]}>
  <a class="brand" href="/" aria-label="Home">
    <img class="brand__mark" src="/icons/main/logo-mark.svg" alt="" />
    <span>Potapov Visual Designer</span>
  </a>

  <nav class="desktop-nav" aria-label="Main navigation">
    <a href="/#projects"><span>Projects</span></a>
    <a href="/about"><span>About</span></a>
    <a href="/contact"><span>Contact</span></a>
    <a href="/files/Vladimir_Potapov_CV.pdf" class="with-icon" target="_blank" rel="noopener noreferrer">
      <img src="/icons/social/pdfdoc.svg" alt="" />
      <span>CV</span>
    </a>
  </nav>

  <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false">
    <img src="/icons/ui/burgermenu.svg" alt="" />
  </button>

  <button class="mobile-menu-backdrop" type="button" aria-label="Close menu"></button>

  <div class="mobile-panel" aria-hidden="true">
    <div class="mobile-panel__top">
      <a class="brand" href="/" aria-label="Home">
        <img class="brand__mark" src="/icons/main/logo-mark.svg" alt="" />
        <span>Potapov Visual Designer</span>
      </a>
      <button class="menu-close" type="button" aria-label="Close menu">
        <img src="/icons/ui/close.svg" alt="" />
      </button>
    </div>
    <nav class="mobile-nav" aria-label="Mobile navigation">
      <a href="/#projects"><span>Projects</span></a>
      <a href="/about"><span>About</span></a>
      <a href="/contact"><span>Contact</span></a>
      <a href="/files/Vladimir_Potapov_CV.pdf" target="_blank" rel="noopener noreferrer">
        <img src="/icons/social/pdfdoc.svg" alt="" />
        <span>CV</span>
      </a>
    </nav>
    <div class="mobile-socials">
      {heroSocialLinks.map((link) => (
        <a href={link.href} aria-label={link.label} target="_blank" rel="noopener noreferrer">
          <img src={link.icon} alt="" />
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const header = document.querySelector(".site-header");
  const openButton = header?.querySelector(".menu-toggle");
  const closeButton = header?.querySelector(".menu-close");
  const backdrop = header?.querySelector(".mobile-menu-backdrop");
  const panel = header?.querySelector(".mobile-panel");

  function setMenu(open) {
    header?.classList.toggle("is-open", open);
    openButton?.setAttribute("aria-expanded", String(open));
    panel?.setAttribute("aria-hidden", String(!open));
    document.documentElement.classList.toggle("menu-open", open);
  }

  openButton?.addEventListener("click", () => setMenu(true));
  closeButton?.addEventListener("click", () => setMenu(false));
  backdrop?.addEventListener("click", () => setMenu(false));
  panel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });
</script>
