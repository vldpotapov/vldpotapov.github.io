---
import NameMarquee from "./NameMarquee.astro";
import { footerSocialLinks } from "../data/site";
---

<footer class="footer" id="contact">
  <div class="footer__portrait">
    <img class="footer__image" src="/images/footer/portrait2.png" alt="Vladimir Potapov portrait" />
    <div class="footer__overlay" aria-hidden="true"></div>
    <NameMarquee />
    <div class="footer__role">// Graphic Designer<br />3D Artist</div>
    <div class="footer__links">
      {footerSocialLinks.map((link) => (
        <a href={link.href} target={link.href.startsWith("mailto:") ? undefined : "_blank"} rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}>
          <img src={link.icon} alt="" />
          <span>{link.label}</span>
        </a>
      ))}
    </div>
    <a class="to-top" href="#" aria-label="Back to top"><img src="/icons/ui/arrow.svg" alt="" /></a>
  </div>
</footer>


