---
type Slide = { src: string; alt: string };
const { slides = [], title = "Project gallery", numberColor } = Astro.props as { slides?: Slide[]; title?: string; numberColor?: string };
const limitedSlides = slides.slice(0, 6);
---

<div class="project-slider" style={numberColor ? `--slider-number-color: ${numberColor}` : undefined} data-project-slider>
  <div class="project-slider__viewport" aria-label={title}>
    {limitedSlides.map((slide, index) => (
      <button class:list={["project-slider__slide", { "is-active": index === 0 }]} type="button" aria-label={`Show image ${index + 1}`} data-project-slide data-slide-index={index}>
        <img src={slide.src} alt={slide.alt} loading="lazy" decoding="async" />
        <span class="project-slider__number">{String(index + 1).padStart(2, "0")}</span>
      </button>
    ))}
  </div>

  <div class="project-slider__controls">
    <button class="project-slider__arrow project-slider__arrow--prev" type="button" aria-label="Previous image" data-slider-prev>
      <img src="/icons/ui/arrow.svg" alt="" />
    </button>
    <button class="project-slider__arrow project-slider__arrow--next" type="button" aria-label="Next image" data-slider-next>
      <img src="/icons/ui/arrow.svg" alt="" />
    </button>
  </div>
</div>

<script>
  document.querySelectorAll("[data-project-slider]").forEach((slider) => {
    const slides = Array.from(slider.querySelectorAll("[data-project-slide]"));
    const previousButton = slider.querySelector("[data-slider-prev]");
    const nextButton = slider.querySelector("[data-slider-next]");
    let activeIndex = 0;

    const setActiveSlide = (index) => {
      if (!slides.length) return;
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((item, itemIndex) => {
        item.classList.toggle("is-active", itemIndex === activeIndex);
      });
    };

    slides.forEach((slide, index) => {
      slide.addEventListener("click", () => {
        if (index === activeIndex) {
          const allSlides = slides.map(s => {
            const i = s.querySelector("img");
            return i ? { src: i.src, alt: i.alt } : null;
          }).filter(Boolean);
          slider.dispatchEvent(new CustomEvent("slider:activate", {
            bubbles: true,
            detail: { slides: allSlides, activeIndex: activeIndex }
          }));
          return;
        }
        setActiveSlide(index);
      });
    });

    previousButton?.addEventListener("click", () => setActiveSlide(activeIndex - 1));
    nextButton?.addEventListener("click", () => setActiveSlide(activeIndex + 1));
  });
</script>