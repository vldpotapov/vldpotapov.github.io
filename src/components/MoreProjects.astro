---
import ProjectMedia from "./ProjectMedia.astro";

const {
  projects = [],
  title = "// More Projects",
  singleColumnBreakpoint = false,
  selected = false,
} = Astro.props;
---

<section
  class:list={[
    "more-projects",
    "section",
    { "more-projects--single-breakpoint": singleColumnBreakpoint, "more-projects--selected": selected },
  ]}
  data-reveal="bottom"
>
  <h2 class="section-label">{title}</h2>
  <div class="more-projects__grid">
    {projects.map((project) => (
      <a class="more-card" href={project.slug}>
        <ProjectMedia
          class="more-card__image"
          src={project.image}
          alt={project.imageAlt ?? `${project.title} preview`}
          ratio="auto"
        />
        <div class="more-card__info">
          <h3>{project.title}</h3>
          <p>({project.year})</p>
        </div>
      </a>
    ))}
  </div>
</section>
